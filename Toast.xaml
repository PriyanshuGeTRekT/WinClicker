<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinClicker notification" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        UseLayoutRounding="True" FontFamily="Segoe UI" Foreground="#E8EAF2">
  <Grid x:Name="Root" Margin="22" Opacity="0">
    <Border CornerRadius="16" Background="#171A23">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.6" Color="#000000"/>
      </Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="#171A23" BorderBrush="#2E3346" BorderThickness="1" Padding="14,12,24,12">
      <StackPanel Orientation="Horizontal">
        <Border x:Name="IconBox" Width="38" Height="38" CornerRadius="12" Background="#3DDC97">
          <Path x:Name="Glyph" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubText" FontSize="12" Foreground="#8A90A6" Margin="0,1,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
